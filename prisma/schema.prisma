// 数据库结构由迁移工作区（/home/sql2mysql）的 SQL 脚本管理。
// 本文件仅用于生成 Prisma Client，不要使用 prisma migrate 修改库结构。
// 目标库：MariaDB 10.11 / TechReadyDB（Prisma 使用 mysql provider）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model t_Observer {
  StockCode String   @db.Char(8)
  UserID    String   @db.VarChar(64)
  Rate      Decimal? @db.Decimal(9, 4)
  RatePrice Decimal? @db.Decimal(12, 4)
  TradeVol  Decimal? @db.Decimal(20, 2)
  PlanID    String?  @db.VarChar(64)
  CreateAt  DateTime @db.DateTime(6)

  @@id([StockCode, UserID])
  @@index([UserID], map: "idx_user")
}

model t_Predict {
  PredictKey   String    @id @db.VarChar(64)
  StockCode    String?   @db.Char(8)
  PredictTime  DateTime? @db.DateTime(6)
  Type         String?   @db.VarChar(16)
  CurrentPrice Decimal?  @db.Decimal(12, 4)
  RSI7         Decimal?  @db.Decimal(9, 4)
  RSI14        Decimal?  @db.Decimal(9, 4)
  BackTest     String?   @db.VarChar(64)
  Memo         String?   @db.VarChar(500)

  @@index([PredictTime], map: "idx_predict_time")
  @@index([StockCode, PredictTime], map: "idx_stock_time")
  @@index([Type, PredictTime], map: "idx_type_time")
}

model t_StockDayLog {
  StockCode             String   @db.Char(8)
  SearchTime            DateTime @db.DateTime(3)
  CurrentPrice          Decimal? @db.Decimal(12, 4)
  YesterdayClosingPrice Decimal? @db.Decimal(12, 4)
  TodayOpeningPrice     Decimal? @db.Decimal(12, 4)
  TodayMinPrice         Decimal? @db.Decimal(12, 4)
  TodayMaxPrice         Decimal? @db.Decimal(12, 4)
  TradingVolume         Decimal? @db.Decimal(20, 2)
  TradingPrice          Decimal? @db.Decimal(20, 2)
  BidBuyPrice           Decimal? @db.Decimal(12, 4)
  BidSellPrice          Decimal? @db.Decimal(12, 4)
  SellBuyRate           Decimal? @db.Decimal(9, 4)

  @@id([StockCode, SearchTime])
  @@index([SearchTime], map: "idx_searchtime")
}

model t_StockDayReport {
  StockCode       String   @db.Char(8)
  ReportDay       DateTime @db.Date
  TodayOpenPrice  Decimal? @db.Decimal(12, 4)
  TodayClosePrice Decimal? @db.Decimal(12, 4)
  TodayMaxPrice   Decimal? @db.Decimal(12, 4)
  TodayMinPrice   Decimal? @db.Decimal(12, 4)
  Rate            Decimal? @db.Decimal(9, 6)
  RatePrice       Decimal? @db.Decimal(12, 4)
  TradingVol      Decimal? @db.Decimal(20, 2)
  TradingPrice    Decimal? @db.Decimal(20, 2)
  TradingPriceAvg Decimal? @db.Decimal(12, 4)
  Memo            String?  @db.VarChar(200)
  MA              Decimal? @db.Decimal(12, 4)
  bollUP          Decimal? @db.Decimal(12, 4)
  bollDown        Decimal? @db.Decimal(12, 4)
  WIDTH           Decimal? @db.Decimal(12, 4)
  BB              Decimal? @db.Decimal(9, 6)
  RSI7            Decimal? @db.Decimal(9, 4)
  RSI14           Decimal? @db.Decimal(9, 4)

  @@id([StockCode, ReportDay])
  @@index([ReportDay], map: "idx_reportday")
}

model t_StockKLine {
  StockCode    String   @db.Char(8)
  Period       String   @db.Char(2)
  TradeTime    DateTime @db.DateTime(3)
  OpenPrice    Decimal? @db.Decimal(12, 4)
  ClosePrice   Decimal? @db.Decimal(12, 4)
  HighPrice    Decimal? @db.Decimal(12, 4)
  LowPrice     Decimal? @db.Decimal(12, 4)
  Volume       Decimal? @db.Decimal(20, 2)
  Turnover     Decimal? @db.Decimal(20, 2)
  ChangeRate   Decimal? @db.Decimal(9, 6)
  ChangeAmount Decimal? @db.Decimal(12, 4)

  @@id([StockCode, Period, TradeTime])
  @@index([Period, TradeTime], map: "idx_period_time")
}

model t_StockNameList {
  StockCode  String    @id @db.Char(8)
  StockName  String    @db.VarChar(100)
  LastUpdate DateTime? @db.DateTime(0)
}

model t_User {
  UserID    String    @id @db.VarChar(64)
  UserName  String    @db.VarChar(64)
  Password  String    @db.VarChar(100)
  RoleID    Int
  CreateAt  DateTime? @db.DateTime(6)
  UpdateAt  DateTime? @db.DateTime(6)
  IsEnabled Boolean

  @@index([UserName], map: "idx_username")
}
